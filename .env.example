# ============================================================
# Shambani Agrovet — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# --- Database (Neon Postgres) ---
DATABASE_URL=                          # Pooled connection (use -pooler hostname)
DATABASE_URL_UNPOOLED=                 # Direct connection (for migrations only)

# --- Auth / JWT ---
JWT_ACCESS_SECRET=                     # Generate: openssl rand -base64 32
JWT_REFRESH_SECRET=                    # Generate: openssl rand -base64 32
COOKIE_SECRET=                         # Generate: openssl rand -base64 32

# --- Payments (IntaSend) ---
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_SECRET=
INTASEND_ENV=sandbox                   # sandbox | live

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Rate Limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bot Protection (Cloudflare Turnstile) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- File Storage ---
STORAGE_PROVIDER=                      # r2 | vercel-blob
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# --- Observability ---
SENTRY_DSN=

# --- Site ---
PUBLIC_SITE_URL=http://localhost:5173   # Production: https://your-domain.com
